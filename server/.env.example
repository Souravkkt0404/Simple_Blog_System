# ---- Server ----
NODE_ENV=development
PORT=5000
# Public URL of this API (used to build OAuth callback URLs)
SERVER_URL=http://localhost:5000
# URL of the React app (CORS origin + OAuth redirect target)
CLIENT_URL=http://localhost:5173

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/simple_blog

# ---- JWT (use long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`) ----
JWT_ACCESS_SECRET=change-me-to-a-long-random-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-refresh-secret-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# ---- Security ----
BCRYPT_SALT_ROUNDS=12
# Auth endpoints (login/register/refresh): max requests per window per IP
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# All other API endpoints
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=500

# ---- OAuth 2.0 (leave empty to disable a provider) ----
# Google callback URL to register: ${SERVER_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook callback URL to register: ${SERVER_URL}/api/v1/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- Seed script (npm run seed) ----
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
